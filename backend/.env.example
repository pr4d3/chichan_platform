# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO BACKEND (RENDER / LOCAL)
# ==========================================

# 1. Cơ sở dữ liệu (Supabase PostgreSQL asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your_project.supabase.co:5432/postgres

# 2. JWT Authentication
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# 3. AI Gemini API
AI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 4. Cấu hình gửi Mail qua SMTP (Tính năng Quên/Đặt lại mật khẩu)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=ChiChan Support
SMTP_TLS=True

# 5. URL Frontend (RẤT QUAN TRỌNG: để tạo đường link reset mật khẩu gửi qua email)
# Ở local: http://localhost:3000
# Trên Render Production: thay bằng URL thật của Frontend (ví dụ: https://chichan.vercel.app)
FRONTEND_URL=https://your-frontend-domain.com

# 6. CORS (Tùy chọn, phân cách bởi dấu phẩy nếu có domain riêng)
ALLOWED_ORIGINS=https://your-frontend-domain.com
