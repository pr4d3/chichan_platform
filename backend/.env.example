# ============================================================================
# SexEd Platform — Backend environment mẫu.
# Copy thành backend/.env rồi điền giá trị thật. KHÔNG commit file .env thật.
# ============================================================================

# PostgreSQL Supabase — connection string của Transaction Pooler (bắt buộc dạng +asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Gemini AI (embedding RAG + roleplay streaming)
AI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# CORS: danh sách origin phân tách bằng dấu phẩy, hoặc * để cho tất cả
ALLOWED_ORIGINS=http://localhost:3000

# Bật SQL echo log (true/false) — mặc định false
ECHO=false
